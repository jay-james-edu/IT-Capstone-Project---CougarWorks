# Copy this file to .env before running locally.

SECRET_KEY=change-this-secret-key
FLASK_ENV=production
DEBUG=False

MONGO_USER=cougarworks_app
MONGO_PASS=change-this-mongo-password
MONGO_HOST=cougarworks-mongo
MONGO_PORT=27017
MONGO_DB_NAME=CougarWorks
MONGO_URI=mongodb://cougarworks_app:change-this-mongo-password@cougarworks-mongo:27017/CougarWorks?authSource=admin

APP_NAME=CougarWorks
SCHOOL_NAME=Columbus State University
SCHOOL_URL=https://www.columbusstate.edu
SESSION_TIMEOUT=3600
PERMANENT_SESSION_LIFETIME=86400

# Optional SMTP settings for email notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@example.com
# FROM_NAME=CougarWorks
